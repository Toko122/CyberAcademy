# Database (required)
DB_URL=postgresql://username:password@localhost:5432/database_name
# Use "disable" for local/internal PostgreSQL or "require" for trusted TLS endpoints.
DB_SSL=disable

# Authentication (required; use at least 32 random characters)
# Production must use the exact same JWT value for every application instance.
# Serve production over HTTPS so the Secure session cookie is accepted.
JWT=replace_with_a_long_random_secret

# One-time administrator provisioning (remove ADMIN_PASSWORD after use)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Cloudinary image storage (required for admin create/upload operations)
# The application accepts JPEG, PNG, WebP, and GIF images up to 5 MB.
CLOUDY_NAME=your_cloud_name
CLOUDY_API_KEY=your_api_key
CLOUDY_SECRET=your_api_secret
